DATABASE_URL="postgresql://user:password@localhost:5432/room_layout"

# Required — session cookies are signed with this. Generate a real random
# value for anything beyond local dev, e.g.: openssl rand -base64 32
SESSION_SECRET="replace-with-a-random-32+-character-value"

# Optional — the AI command bar (lib/ai/claudeProvider.ts) and the floor-plan
# upload feature (lib/ai/parseFloorPlan.ts) won't work without this, but the
# rest of the app runs fine.
ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-4-5-20250929"

# Optional — required for the "upload a floor plan" room-creation flow
# (app/rooms/upload) to work. This is a Vercel Blob read/write token —
# create/link a Blob store to the Vercel project and this gets set
# automatically there. Without it, floor-plan uploads will fail; manual
# rectangular room creation at /rooms still works fine.
BLOB_READ_WRITE_TOKEN=""

# Optional — overrides the default dev password `npm run db:seed` sets for
# the seeded admin user (dan.hurder@greatplainshospitality.com). Defaults to
# "changeme123" if unset; change this before seeding anything but a
# throwaway local database.
# SEED_ADMIN_PASSWORD=""
